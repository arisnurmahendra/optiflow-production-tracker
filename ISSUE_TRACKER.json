{
  "repository": "arisnurmahendra/optiflow-production-tracker",
  "sync_policy": {
    "source_of_truth": "ISSUE_TRACKER.md",
    "github_issue_number_field": "github_issue",
    "close_rule": "Local status Closed is allowed only after the linked GitHub Issue is closed or the item is explicitly local-only.",
    "pre_code_rule": "Update DATA_SCHEMA.md and BUSINESS_PROCESS.md before code when schema, workflow, parameter, or variable contracts change."
  },
  "labels": [
    {
      "name": "type:docs",
      "color": "0075CA",
      "description": "Documentation or contract changes."
    },
    {
      "name": "type:feature",
      "color": "0E8A16",
      "description": "New feature."
    },
    {
      "name": "type:bug",
      "color": "D73A4A",
      "description": "Bug or regression."
    },
    {
      "name": "type:security",
      "color": "B60205",
      "description": "Security, RBAC, PII, audit, or POL.ISMS.001."
    },
    {
      "name": "type:test",
      "color": "5319E7",
      "description": "Test runner, smoke test, or verification."
    },
    {
      "name": "area:frontend",
      "color": "1D76DB",
      "description": "Vue, Vite, UI, state, or IndexedDB."
    },
    {
      "name": "area:backend",
      "color": "0052CC",
      "description": "Google Apps Script, API, or validation."
    },
    {
      "name": "area:data",
      "color": "006B75",
      "description": "Sheets schema, recap, or event sourcing."
    },
    {
      "name": "area:process",
      "color": "FBCA04",
      "description": "SOP, workflow, QCC, or pilot rollout."
    },
    {
      "name": "area:deployment",
      "color": "C5DEF5",
      "description": "Clasp or Apps Script deployment."
    },
    {
      "name": "area:ui-ux",
      "color": "D4C5F9",
      "description": "Visual design, ergonomics, or accessibility."
    },
    {
      "name": "priority:p0",
      "color": "B60205",
      "description": "Blocking or high risk."
    },
    {
      "name": "priority:p1",
      "color": "D93F0B",
      "description": "Required for MVP."
    },
    {
      "name": "priority:p2",
      "color": "FBCA04",
      "description": "Important after base MVP."
    },
    {
      "name": "priority:p3",
      "color": "C2E0C6",
      "description": "Future backlog."
    },
    {
      "name": "status:blocked",
      "color": "000000",
      "description": "Waiting for decision or dependency."
    },
    {
      "name": "sync:github",
      "color": "7057FF",
      "description": "Needs GitHub Issue sync."
    }
  ],
  "milestones": [
    {
      "title": "M0 - Contracts & Planning",
      "description": "All documentation contracts are aligned before coding."
    },
    {
      "title": "M1 - Project Bootstrap",
      "description": "Vue, Vite, GAS, Clasp, and single-file build are ready."
    },
    {
      "title": "M2 - Backend Foundation",
      "description": "Sheet schema, auth, RBAC, validation, and audit basics are ready."
    },
    {
      "title": "M3 - Operator Mobile MVP",
      "description": "Operator can submit production data from mobile."
    },
    {
      "title": "M4 - Offline Sync & Conflict Control",
      "description": "IndexedDB queue, event sourcing, CONFLICT_PENDING, and HITL approval are ready."
    },
    {
      "title": "M5 - Supervisor Control & Recap",
      "description": "Quarantine, closing, adjustment, recap, and dashboards are ready."
    },
    {
      "title": "M6 - Security, Testing & Deployment",
      "description": "POL.ISMS.001 hardening, test runner, smoke test, and deployment are ready."
    },
    {
      "title": "M7 - QCC Report & Rollout",
      "description": "Pilot rollout, SOP, and QCC Step 1-8 report package are ready."
    }
  ],
